# ==============================================================================
# KELA AI Platform - Environment Configuration Template
# ==============================================================================

# Network & Security Hardening
# Comma-separated list of trusted browser origins authorized to communicate with KELA backend.
# Default if unspecified: http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175
KELA_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5175,http://127.0.0.1:5175

# Cryptographic Token for PC and System Controls
# If left empty, KELA will automatically generate a persistent 256-bit token in .kela_local_token (gitignored).
# X-KELA-Token or Authorization: Bearer <token> must match this token for all sensitive /api/pc/* endpoints.
KELA_LOCAL_AGENT_TOKEN=

# Local Model Provider (Ollama)
OLLAMA_URL=http://127.0.0.1:11434
KELA_DEFAULT_MODEL=qwen2.5-coder:7b

# Inference Provider Architecture Routing
# Supported values: 'ollama' (default local), 'cloud' (OpenAI-compatible fallback or primary)
KELA_ACTIVE_PROVIDER=ollama

# Optional Cloud Inference Provider (OpenAI / OpenRouter / vLLM / LiteLLM compatible)
KELA_CLOUD_API_KEY=
KELA_CLOUD_API_URL=https://api.openai.com/v1
KELA_CLOUD_MODEL=gpt-4o
